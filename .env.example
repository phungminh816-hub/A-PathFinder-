# Static server
APP_HOST=127.0.0.1
APP_PORT=8000

# Initial map viewport and local graph boundary
MAP_CENTER_LAT=21.028
MAP_CENTER_LON=105.830
MAP_DEFAULT_ZOOM=12
MAP_MAX_ZOOM=19
MAP_MIN_LAT=20.980
MAP_MAX_LAT=21.075
MAP_MIN_LON=105.770
MAP_MAX_LON=105.890
MAP_DATA_URL=map_data.json

# Leaflet base tiles
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Address autocomplete (set false to use map clicks only)
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_LIMIT=5
GEOCODING_LANGUAGE=vi
GEOCODING_DEBOUNCE_MS=1000
